{
  "name": "subs-tracker",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && $npm_execpath run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md",
    "release": "bumpp && bun run changelog && git add CHANGELOG.md && git commit --amend --no-edit && git push --follow-tags",
    "release:minor": "bumpp minor && bun run changelog && git add CHANGELOG.md && git commit --amend --no-edit && git push --follow-tags",
    "release:major": "bumpp major && bun run changelog && git add CHANGELOG.md && git commit --amend --no-edit && git push --follow-tags",
    "release:dry": "bumpp --no-commit --no-tag --no-push"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "date-fns": "^4.4.0",
    "hono": "^4.13.9",
    "lucide": "^1.48.0",
    "psl": "^1.15.0",
    "resend": "^6.30.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/bun": "^1.4.2",
    "@types/psl": "1.1.3",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-ssr-components": "^0.8.0",
    "wrangler": "^4.141.0"
  }
}
